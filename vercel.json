{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p .vercel-empty && touch .vercel-empty/.keep",
  "outputDirectory": ".vercel-empty",
  "functions": { "api/dashboard.js": { "includeFiles": "index.html" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/dashboard" }]
}
